# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` for local development. NEVER commit `.env.local`.
# For production, use `apphosting.yaml` (non-secret values) and Cloud Secret Manager
# (secret values). See README → "Environment variables".
#
# Every variable is OPTIONAL: with nothing set the site still runs using the built-in
# seed data and safe fallbacks.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time and are
# therefore PUBLIC. Never put a secret in a NEXT_PUBLIC_* variable.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical public URL, no trailing slash. Used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Firebase Web App config (public) ─────────────────────────────────────────
# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to point the browser SDK *and* the Admin SDK at the local emulators.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# ── Firebase Admin SDK (SERVER ONLY — secret) ────────────────────────────────
# On Firebase App Hosting / Cloud Run, leave these empty: Application Default
# Credentials are used automatically.
# Locally, EITHER set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path
# (kept outside the repo), OR set the two values below from that JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CLIENT_EMAIL=
# Keep the surrounding quotes and the literal \n sequences.
FIREBASE_PRIVATE_KEY=

# Emulator hosts (picked up automatically by the Admin SDK when set).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# International format, digits only, no "+" (e.g. 15551234567). Leave empty to hide
# all WhatsApp buttons.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional prefilled message. Supports the {cafe} placeholder.
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi {cafe}! I have a question.

# ── Google Maps ──────────────────────────────────────────────────────────────
# Maps Embed API key (public by design). RESTRICT it in Google Cloud Console to
# "HTTP referrers" for your domain(s) and to the "Maps Embed API" only.
# Leave empty to show a static location card with a "Get directions" link instead.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# ── Instagram ────────────────────────────────────────────────────────────────
# Public handle without "@". Used for the profile link and the fallback card.
NEXT_PUBLIC_INSTAGRAM_HANDLE=
# Long-lived Instagram API access token (SERVER ONLY — secret). Leave empty to use
# the fallback card. Tokens expire after ~60 days; see README → "Instagram".
INSTAGRAM_ACCESS_TOKEN=
