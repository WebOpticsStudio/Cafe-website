rules_version = '2';

// Cloud Storage security rules.
//   • menu/**  – public read (photos shown on the website); admin-only writes,
//                images only, max 5 MB.
//   • everything else – denied.
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isReasonableImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    match /menu/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isReasonableImage();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
